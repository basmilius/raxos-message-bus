{
    "name": "raxos/message-bus",
    "description": "A Message Bus implementation for Raxos.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raxos\\MessageBus\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "jetbrains/phpstorm-attributes": "^1.2",
        "php": ">=8.5",
        "php-amqplib/php-amqplib": "^v3.7",
        "raxos/collection": "*",
        "raxos/contract": "*",
        "raxos/error": "*",
        "raxos/foundation": "*",
        "raxos/terminal": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    }
}
